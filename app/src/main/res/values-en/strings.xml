    <string name="about_title">About AngelaCam</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_intro_title">Overview</string>
    <string name="about_intro_body">A privacy-first native Android camera: take photos and videos, browse the built-in gallery, and edit photos with a full set of everyday adjustments.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">• Connects to GitHub only to check for updates; no user data is uploaded\n• Never records where photos were taken\n• The microphone is requested only while recording video; if you decline, videos are recorded silently\n• The gallery only includes media captured with this app</string>
    <string name="about_update_title">Updates</string>
    <string name="about_update_body">Tap \"Check for Updates\" to see if a new version is available (connects to GitHub only). You can also download the installer from the GitHub Releases page and install it over the current app — the signature matches, so there\'s no need to uninstall first.</string>
