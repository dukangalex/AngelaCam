<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的数据提取规则：云备份与设备间迁移都排除拍摄记录索引，
     它只含本机媒体 URI，迁到新设备也无意义且属用户数据 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="captures.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="captures.json" />
    </device-transfer>
</data-extraction-rules>
